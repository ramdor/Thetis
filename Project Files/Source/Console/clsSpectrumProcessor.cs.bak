        private bool IsReceiverInLocalMox(int receiverId)
        {
            if (receiverId < 0)
                return false;

            if (!Display.MOX)
                return false;

            if (receiverId == 0)
                return !_console.VFOBTX || (_console.VFOBTX && !_console.RX2Enabled);

            if (receiverId == 1)
                return _console.VFOBTX && _console.RX2Enabled;

            return false;
        }

        private bool IsReceiverShowingTransmitter(int receiverId)
        {
            return IsReceiverInLocalMox(receiverId) && !_console.DisplayDuplex;
        }

        public Form ShowReceiverTestForm(int receiverId, float? min_dBm = null, float? max_dBm = null)
        {
            ThrowIfDisposed();
            ValidateReceiverId(receiverId);

            if (!ContainsReceiver(receiverId))
                AddReceiver(receiverId, DefaultPixels, DefaultFrameRate, DefaultFftSize);

            SpectrumTestForm form = new SpectrumTestForm(this, receiverId, min_dBm, max_dBm);
            form.Show();
            return form;
        }

        public void Dispose()
        {
            if (_disposed) return;

            _disposed = true;
            _workerRunning = false;

            if (_workerThread != null && _workerThread.IsAlive)
                _workerThread.Join(250);

            UnsubscribeDelegates();
            Clear();
        }

        private void RunWorker()
        {
            HiPerfTimer scheduleTimer = new HiPerfTimer();
            HiPerfTimer loopTimer = new HiPerfTimer();
            HiPerfTimer sleepTimer = new HiPerfTimer();
            double fractionalMilliseconds = 0.0;
            double sleepOverrunMilliseconds = 0.0;

            scheduleTimer.Start();

            while (_workerRunning)
            {
                loopTimer.Reset();

                SpectrumEndpoint[] endpoints = GetEndpointArray();
                long nowTicks = GetHiPerfTimerTicks(scheduleTimer);
                Action frameAvailable = FrameAvailable;

                for (int i = 0; i < endpoints.Length; i++)
                {
                    if (endpoints[i].ProcessFrame(nowTicks))
                    {
                        frameAvailable?.Invoke();
                    }
                }

                nowTicks = GetHiPerfTimerTicks(scheduleTimer);
                double delayMilliseconds = GetWorkerDelayMilliseconds(endpoints, nowTicks);
                delayMilliseconds = delayMilliseconds - loopTimer.ElapsedMsec - sleepOverrunMilliseconds;

                if (delayMilliseconds < 0.0)
                {
                    delayMilliseconds = 0.0;
                    fractionalMilliseconds = 0.0;
                }

                int integerDelayMilliseconds = (int)delayMilliseconds;
                fractionalMilliseconds += delayMilliseconds - integerDelayMilliseconds;
                int integerFractionMilliseconds = (int)fractionalMilliseconds;
                fractionalMilliseconds -= integerFractionMilliseconds;
                int requestedSleepMilliseconds = integerDelayMilliseconds + integerFractionMilliseconds;
                sleepOverrunMilliseconds = 0.0;

                if (requestedSleepMilliseconds > 0)
                {
                    sleepTimer.Reset();
                    Thread.Sleep(requestedSleepMilliseconds);
                    sleepOverrunMilliseconds = sleepTimer.ElapsedMsec - requestedSleepMilliseconds;
                }
                else if (fractionalMilliseconds > 0.0)
                {
                    sleepTimer.Reset();
                    while (_workerRunning && sleepTimer.ElapsedMsec <= fractionalMilliseconds) ;
                    fractionalMilliseconds = sleepTimer.ElapsedMsec - fractionalMilliseconds;
            }
        }
        }

        private static long GetHiPerfTimerTicks(HiPerfTimer timer)
        {
            return (long)(timer.ElapsedMsec * TimeSpan.TicksPerMillisecond);
        }

        private static double GetWorkerDelayMilliseconds(SpectrumEndpoint[] endpoints, long nowTicks)
        {
            if (endpoints == null || endpoints.Length == 0)
            {
                return 20.0;
            }

            double minimumDelayMilliseconds = double.PositiveInfinity;
            for (int i = 0; i < endpoints.Length; i++)
            {
                double delayMilliseconds = endpoints[i].GetFrameDelayMilliseconds(nowTicks);
                if (delayMilliseconds < minimumDelayMilliseconds)
                {
                    minimumDelayMilliseconds = delayMilliseconds;
                }
            }

            if (double.IsPositiveInfinity(minimumDelayMilliseconds))
            {
                return 20.0;
            }

            if (minimumDelayMilliseconds > 20.0)
            {
                return 20.0;
            }

            return minimumDelayMilliseconds;
        }

        private void SubscribeDelegates()
        {
            _console.CentreFrequencyHandlers += OnCentreFrequencyChanged;
            _console.HWSampleRateChangedHandlers += OnHWSampleRateChanged;
            _console.PowerChangeHanders += OnPowerChanged;
            _console.AttenuatorDataChangedHandlers += OnAttenuatorDataChanged;
            _console.PreampModeChangedHandlers += OnPreampModeChanged;
            _console.BandChangeHandlers += OnBandChanged;
        }

        private void UnsubscribeDelegates()
        {
            _console.CentreFrequencyHandlers -= OnCentreFrequencyChanged;
            _console.HWSampleRateChangedHandlers -= OnHWSampleRateChanged;
            _console.PowerChangeHanders -= OnPowerChanged;
            _console.AttenuatorDataChangedHandlers -= OnAttenuatorDataChanged;
            _console.PreampModeChangedHandlers -= OnPreampModeChanged;
            _console.BandChangeHandlers -= OnBandChanged;
        }
        
        private void OnBandChanged(int rx, Band oldBand, Band newBand)
        {
            ResetNoiseFloorForReceiverEvent(rx);
        }
        private void OnCentreFrequencyChanged(int rx, double oldFreq, double newFreq, Band band, double offset)
        {
            SpectrumEndpoint[] endpoints = GetEndpointArray();

            for (int i = 0; i < endpoints.Length; i++)
            {
                if (endpoints[i].MatchesReceiverEvent(rx))
                    endpoints[i].SyncFrequencies();
            }
        }

        private void OnHWSampleRateChanged(int rx, int oldRate, int newRate)
        {
            SpectrumEndpoint[] endpoints = GetEndpointArray();
            int sampleRate = ValidateSampleRate(newRate);

            for (int i = 0; i < endpoints.Length; i++)
            {
                if (endpoints[i].MatchesReceiverEvent(rx))
                    endpoints[i].SetSampleRate(sampleRate);
            }
        }

        private void OnAttenuatorDataChanged(int rx, int oldAtt, int newAtt)
        {
            ResetNoiseFloorForReceiverEvent(rx);
        }

        private void OnPreampModeChanged(int rx, PreampMode oldMode, PreampMode newMode)
        {
            ResetNoiseFloorForReceiverEvent(rx);
        }

        private void ResetNoiseFloorForReceiverEvent(int rx)
        {
            SpectrumEndpoint[] endpoints = GetEndpointArray();

            for (int i = 0; i < endpoints.Length; i++)
            {
                if (endpoints[i].MatchesReceiverEvent(rx))
                    endpoints[i].ResetNoiseFloor();
            }
        }

        private void OnPowerChanged(bool oldPower, bool newPower)
        {
            if (!oldPower || newPower) return;

            SpectrumEndpoint[] endpoints = GetEndpointArray();
            for (int i = 0; i < endpoints.Length; i++)
                endpoints[i].ClearData();
        }

        private SpectrumEndpoint[] GetEndpointArray()
        {
            return _endpointSnapshot;
        }

        private bool TryGetReceiverEndpoint(int receiverId, out SpectrumEndpoint endpoint)
        {
            endpoint = null;
            if (receiverId < 0) return false;

            lock (_endpointsLock)
            {
                return _endpoints.TryGetValue(receiverId, out endpoint);
            }
        }

        private bool TryDetachReceiverEndpoint(int receiverId, out SpectrumEndpoint endpoint)
        {
            endpoint = null;
            if (receiverId < 0) return false;

            lock (_endpointsLock)
            {
                if (!_endpoints.TryGetValue(receiverId, out endpoint))
                    return false;

                _endpoints.Remove(receiverId);
                UpdateEndpointSnapshotLocked();
                return true;
            }
        }

        private void UpdateEndpointSnapshotLocked()
        {
            if (_endpoints.Count == 0)
            {
                _endpointSnapshot = Array.Empty<SpectrumEndpoint>();
                return;
            }

            SpectrumEndpoint[] endpoints = new SpectrumEndpoint[_endpoints.Count];
            _endpoints.Values.CopyTo(endpoints, 0);
            _endpointSnapshot = endpoints;
        }

        private void ThrowIfDisposed()
        {
            if (_disposed) throw new ObjectDisposedException(GetType().Name);
        }

        private static void ValidateReceiverId(int receiverId)
        {
            if (receiverId < 0) throw new ArgumentOutOfRangeException(nameof(receiverId), "receiverId must be zero or greater.");
        }

        private static int ClampInt(int value, int minimum, int maximum)
        {
            if (value < minimum) return minimum;
            if (value > maximum) return maximum;
            return value;
        }

        private static int ValidateSampleRate(int sampleRate)
        {
            if (sampleRate <= 0)
                throw new ArgumentOutOfRangeException(nameof(sampleRate), "sampleRate must be greater than zero.");

            return sampleRate;
        }

        private static double ClampZoomSlider(double value)
        {
            if (double.IsNaN(value) || double.IsInfinity(value)) return 0.0;
            if (value < 0.0) return 0.0;
            if (value > 1.0) return 1.0;
            return value;
        }

        private static double ClampPanSlider(double value)
        {
            if (double.IsNaN(value) || double.IsInfinity(value)) return 0.5;
            if (value < 0.0) return 0.0;
            if (value > 1.0) return 1.0;
            return value;
        }

        private static int NormalizeFftSize(int fftSize)
        {
            int clamped = ClampInt(fftSize, DefaultFftSize, DefaultMaxFftSize);
            int best = DefaultFftSize;
            int bestDistance = Math.Abs(clamped - best);

            for (int value = DefaultFftSize << 1; value <= DefaultMaxFftSize; value <<= 1)
        {
                int distance = Math.Abs(clamped - value);
                if (distance < bestDistance)
                {
                    best = value;
                    bestDistance = distance;
                }
            }

            return best;
        }

        private sealed class SpectrumEndpoint
        {
            private const double ViewportEpsilon = 0.000001;
            private readonly object _syncRoot = new object();
            private readonly clsSpectrumProcessor _owner;
            private readonly Console _console;
            private readonly int _receiverId;
            private readonly int _displayId;
            private readonly int _txDisplayId;
            private readonly int _maxFftSize;
            private readonly SpecHPSDR _spec;
            private readonly SpecHPSDR _txSpec;

            private float[] _latestPixels;
            private float[] _workingPixels;
            private int _pixels;
            private int _frameRate;
            private int _configuredSampleRate;
            private int _txConfiguredSampleRate;
            private int _fftSize;
            private int _HzSpan;
            private int _txHzSpan;
            private int _HzLeft;
            private int _txHzLeft;
            private int _blockSize;
            private int _txBlockSize;
            private int _windowType;
            private int _detectorTypePan;
            private int _averageMode;
            private double _averageTau;
            private bool _averageOn;
            private bool _peakOn;
            private bool _normOneHzPan;
            private double _zoomSlider;
            private double _panSlider;
            private bool _hasZoomCentreFrequency;
            private bool _zoomCentreTracksReceiverCentre;
            private double _zoomCentreFrequencyHz;
            private double _zoomCentreOffsetHz;
            private double _zoomCentreAnchorPosition;
            private bool _enabled;
            private bool _hasData;
            private bool _noiseFloorGood;
            private bool _fastAttackNoiseFloor;
            private float _noiseFloorUnshiftedDbm;
            private float _fftBinAverage;
            private float _lerpAverage;
            private float _attackTimeInMs;
            private long _lastFastAttackUtcTicks;
            private bool _shutdown;
            private int _dataIndex;
            private long _nextReadUtcTicks;

            private const long SchedulingToleranceTicks = TimeSpan.TicksPerMillisecond * 2;
            private const float FastPow10Scale = 2786635.259211258f;
            private const int FastPow10Bias = 0x3f800000;

            public SpectrumEndpoint(clsSpectrumProcessor owner, Console console, int receiverId, int pixels, int frameRate, int fftSize, SpecHPSDR templateSpec, SpecHPSDR txTemplateSpec)
            {
                _owner = owner;
                _console = console;
                _receiverId = receiverId;
                _pixels = pixels;
                _frameRate = frameRate;
                _configuredSampleRate = templateSpec != null ? templateSpec.SampleRate : DefaultSampleRate;
                _txConfiguredSampleRate = txTemplateSpec != null ? txTemplateSpec.SampleRate : _configuredSampleRate;                
                _fftSize = NormalizeFftSize(fftSize);

                //int clip = templateSpec != null ? templateSpec.Clip : _fftSize;
                //float clip_ratio = clip / (float)_fftSize;
                //_HzSpan = _configuredSampleRate - ((int)Math.Floor(_configuredSampleRate * clip_ratio) * 2);

                //clip = txTemplateSpec != null ? txTemplateSpec.Clip : _fftSize;
                //clip_ratio = clip / (float)_fftSize;
                //_txHzSpan = _txConfiguredSampleRate - ((int)Math.Floor(_txConfiguredSampleRate * clip_ratio) * 2);

                _HzLeft = templateSpec != null ? templateSpec.LowFreq : 0;
                int hzRight = templateSpec != null ? templateSpec.HighFreq : 0;
                _txHzLeft = txTemplateSpec != null ? txTemplateSpec.LowFreq : 0;
                int txHzRight = txTemplateSpec != null ? txTemplateSpec.HighFreq : 0;

                _HzSpan = hzRight - _HzLeft;
                _txHzSpan = txHzRight - _txHzLeft;

                _blockSize = templateSpec != null ? templateSpec.BlockSize : ResolveDefaultBlockSize(_configuredSampleRate);
                _txBlockSize = txTemplateSpec != null ? txTemplateSpec.BlockSize : ResolveDefaultBlockSize(_txConfiguredSampleRate);
                _windowType = templateSpec != null ? templateSpec.WindowType : DefaultWindowType;
                _detectorTypePan = templateSpec != null ? templateSpec.DetTypePan : DefaultDetectorTypePan;
                _averageMode = templateSpec != null ? templateSpec.AverageMode : DefaultAverageMode;
                _averageTau = templateSpec != null ? templateSpec.AvTau : DefaultAverageTau;
                _averageOn = templateSpec != null && templateSpec.AverageOn;
                _peakOn = templateSpec != null && templateSpec.PeakOn;
                _normOneHzPan = templateSpec != null && templateSpec.NormOneHzPan;
                _zoomSlider = 0.0;
                _panSlider = 0.5;
                _hasZoomCentreFrequency = false;
                _zoomCentreTracksReceiverCentre = false;
                _zoomCentreFrequencyHz = 0.0;
                _zoomCentreOffsetHz = 0.0;
                _zoomCentreAnchorPosition = 0.5;
                _maxFftSize = DefaultMaxFftSize;
                _enabled = true;
                _noiseFloorUnshiftedDbm = DefaultNoiseFloorValue;
                _fftBinAverage = DefaultNoiseFloorValue;
                _lerpAverage = DefaultNoiseFloorValue;
                _attackTimeInMs = 2000.0f;
                ResetNoiseFloorLocked();

                EnsurePixelBuffersLocked(_pixels);
                ClearPixelBuffersLocked();

                _displayId = cmaster.AllocAnalyzer(ReceiverAnalyzerType, _receiverId, _maxFftSize);
                if (_displayId < 0)
                    throw new InvalidOperationException("Unable to allocate receiver analyzer for receiver id " + _receiverId.ToString() + ".");

                _txDisplayId = cmaster.AllocAnalyzer(TransmitterAnalyzerType, 0, _maxFftSize);
                if (_txDisplayId < 0)
                {
                    try { cmaster.FreeAnalyzer(_displayId); } catch { }
                    throw new InvalidOperationException("Unable to allocate transmitter analyzer.");
                }

                _spec = new SpecHPSDR(_displayId)
                {
                    Update = false
                };

                _txSpec = new SpecHPSDR(_txDisplayId)
                {
                    Update = false
                };

                Refresh();
                cmaster.RunAnalyzer(_displayId, 1);
                cmaster.RunAnalyzer(_txDisplayId, 1);
            }
            public bool MatchesReceiverEvent(int rx)
            {
                return (_receiverId + 1) == rx;
            }

            public void SetPixels(int pixels)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || pixels == _pixels) return;

                    _pixels = pixels;
                    ClearPixelBuffersLocked();

                    _spec.Pixels = _pixels;
                    _spec.resetPixelBuffers();
                    _txSpec.Pixels = _pixels;
                    _txSpec.resetPixelBuffers();
                    _hasData = false;
                    _nextReadUtcTicks = 0;
                }
            }

            public void SetFrameRate(int frameRate)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || frameRate == _frameRate) return;

                    _frameRate = frameRate;
                    _spec.FrameRate = _frameRate;
                    _txSpec.FrameRate = _frameRate;
                    _nextReadUtcTicks = 0;
                }
            }

            public void SetFFTSize(int fftSize)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || fftSize == _fftSize) return;

                    _fftSize = fftSize;
                    RefreshLocked();
                }
            }

            public void SetWindowType(int windowType)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || windowType == _windowType) return;

                    _windowType = windowType;
                    RefreshLocked();
                }
            }

            public void SetDetectorTypePan(int detectorTypePan)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || detectorTypePan == _detectorTypePan) return;

                    _detectorTypePan = detectorTypePan;
                    RefreshLocked();
                }
            }

            public void SetAverageMode(int averageMode)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || averageMode == _averageMode) return;

                    _averageMode = averageMode;
                    _averageOn = averageMode != 0;
                    RefreshLocked();
                }
            }

            public void SetAverageTauSeconds(double averageTau)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || Math.Abs(_averageTau - averageTau) < 0.000001) return;

                    _averageTau = averageTau;
                    RefreshLocked();
                }
            }

            public void SetNormOneHzPan(bool normOneHzPan)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || normOneHzPan == _normOneHzPan) return;

                    _normOneHzPan = normOneHzPan;
                    RefreshLocked();
                }
            }

            public void SetSampleRate(int sampleRate)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || sampleRate == _configuredSampleRate) return;

                    _configuredSampleRate = sampleRate;
                    _blockSize = ResolveDefaultBlockSize(_configuredSampleRate);
                    RefreshLocked();
                }
            }

            public void SetZoomSlider(double zoomSlider)
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    _zoomSlider = zoomSlider;
                    RefreshLocked();
                }
            }

            public void SetPanSlider(double panSlider)
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    if (IsZoomFullyOut(_zoomSlider))
                    {
                        if (Math.Abs(_panSlider - 0.5) < ViewportEpsilon) return;

                        _panSlider = 0.5;
                        RefreshLocked();
                        return;
                    }

                    if (Math.Abs(_panSlider - panSlider) < ViewportEpsilon && !_hasZoomCentreFrequency) return;

                    _hasZoomCentreFrequency = false;
                    _panSlider = panSlider;
                    RefreshLocked();
                }
            }

            public void SetZoomCentreFrequency(double frequencyHz, bool trackReceiverCentre)
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    double centreHz = GetReceiverCentreFrequencyHz();
                    _hasZoomCentreFrequency = true;
                    _zoomCentreTracksReceiverCentre = trackReceiverCentre;
                    _zoomCentreFrequencyHz = frequencyHz;
                    _zoomCentreOffsetHz = frequencyHz - centreHz;
                    UpdateZoomCentreAnchorPositionLocked();
                }
            }

            public void SetEnabled(bool enabled)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || enabled == _enabled) return;

                    _enabled = enabled;
                    cmaster.RunAnalyzer(_displayId, _enabled ? 1 : 0);
                    cmaster.RunAnalyzer(_txDisplayId, _enabled ? 1 : 0);
                    _nextReadUtcTicks = 0;
                }
            }

            public void SyncFrequencies()
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    if (_hasZoomCentreFrequency && _zoomCentreTracksReceiverCentre)
                    {
                        double centreHz = GetReceiverCentreFrequencyHz();
                        _zoomCentreFrequencyHz = centreHz + _zoomCentreOffsetHz;
                        _nextReadUtcTicks = 0;
                        return;
                    }

                    if (_hasZoomCentreFrequency)
                        RefreshLocked();
                    else
                        _nextReadUtcTicks = 0;
                }
            }

            public void Refresh()
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    RefreshLocked();
                }
            }

            public void ResetBuffers()
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    _spec.resetPixelBuffers();
                    _txSpec.resetPixelBuffers();
                    ClearPixelBuffersLocked();
                    ResetNoiseFloorLocked();
                    _hasData = false;
                    _nextReadUtcTicks = 0;
                }
            }

            public void ClearData()
            {
                lock (_syncRoot)
                {
                    ClearPixelBuffersLocked();
                    ResetNoiseFloorLocked();
                    _hasData = false;
                    _nextReadUtcTicks = 0;
                }
            }

            public void ResetNoiseFloor()
            {
                lock (_syncRoot)
                {
                    ResetNoiseFloorLocked();
                }
            }

            public double GetFrameDelayMilliseconds(long nowUtcTicks)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || !_enabled) return double.PositiveInfinity;
                    if (_nextReadUtcTicks <= 0) return 0.0;

                    long delayTicks = _nextReadUtcTicks - SchedulingToleranceTicks - nowUtcTicks;
                    if (delayTicks <= 0) return 0.0;

                    return delayTicks / (double)TimeSpan.TicksPerMillisecond;
                }
            }

            public bool ProcessFrame(long nowUtcTicks)
            {
                lock (_syncRoot)
                {
                    if (_shutdown || !_enabled) return false;

                    long frameIntervalTicks = TimeSpan.TicksPerSecond / Math.Max(1, _frameRate);
                    if (_nextReadUtcTicks <= 0)
                    {
                        _nextReadUtcTicks = nowUtcTicks;
                    }
                    else if (nowUtcTicks + SchedulingToleranceTicks < _nextReadUtcTicks)
                    {
                        return false;
                    }

                    long nextReadUtcTicks = _nextReadUtcTicks + frameIntervalTicks;
                    if (nextReadUtcTicks <= nowUtcTicks)
                    {
                        nextReadUtcTicks = nowUtcTicks + frameIntervalTicks;
                    }

                    _nextReadUtcTicks = nextReadUtcTicks;

                    int flag = 0;
                    int displayId = ResolveReadDisplayId();
                    if (displayId == _txDisplayId)
                        SyncTransmitterSettingsLocked();
                    unsafe
                    {
                        fixed (float* ptr = &_workingPixels[0])
                            SpecHPSDRDLL.GetPixels(displayId, 0, ptr, ref flag);
                    }

                    if (flag == 1)
                    {
                        float offset = GetPixelOffset(displayId);
                        bool processNoiseFloor = displayId == _displayId;

                        if (processNoiseFloor)
                        {
                            float averageSum = 0.0f;
                            int averageCount = 1;
                            float currentAverage = _fftBinAverage + 2.0f;

                            for (int i = 0; i < _pixels; i++)
                            {
                                float pixel = _workingPixels[i] + offset;
                                _workingPixels[i] = pixel;

                                if (pixel < currentAverage)
                                {
                                    averageSum += FastPow10Raw(pixel);
                                    averageCount++;
                                }
                            }

                            ProcessNoiseFloorLocked(averageCount, averageSum, _pixels, nowUtcTicks);
                        }
                        else if (offset != 0.0f)
                        {
                            for (int i = 0; i < _pixels; i++)
                                _workingPixels[i] += offset;
                        }

                        float[] temp = _latestPixels;
                        _latestPixels = _workingPixels;
                        _workingPixels = temp;

                        _hasData = true;
                    }
                    else if (!_hasData)
                    {
                        return false;
                    }

                    _dataIndex++;
                    if (_dataIndex >= DataIndexWrap) _dataIndex = 1;

                    return true;
                }
            }

            public bool TryGetGoodNoiseFloor(out float noiseFloorDbm)
            {
                lock (_syncRoot)
                {
                    if (!_noiseFloorGood)
                    {
                        noiseFloorDbm = DefaultNoiseFloorValue;
                        return false;
                    }

                    noiseFloorDbm = _noiseFloorUnshiftedDbm + _owner.NFshiftDBM;
                    return !_shutdown;
                }
            }

            public bool TryGetLatestPixels(out float[] pixels, out int dataIndex)
            {
                lock (_syncRoot)
                {
                    pixels = new float[_pixels];
                    Buffer.BlockCopy(_latestPixels, 0, pixels, 0, _pixels * sizeof(float));
                    dataIndex = _dataIndex;
                    return _hasData;
                }
            }
            public bool TryCopyLatestPixels(float[] destination, out int pixelCount, out int dataIndex)
            {
                if (destination == null) throw new ArgumentNullException(nameof(destination));

                lock (_syncRoot)
                {
                    pixelCount = _pixels;
                    dataIndex = _dataIndex;

                    if (destination.Length < _pixels)
                        return false;

                    Buffer.BlockCopy(_latestPixels, 0, destination, 0, _pixels * sizeof(float));
                    return _hasData;
                }
            }

            public bool TryGetViewport(out double zoomSlider, out double panSlider)
            {
                lock (_syncRoot)
                {
                    zoomSlider = _zoomSlider;
                    panSlider = GetEffectivePanSliderLocked();
                    return !_shutdown;
                }
            }

            public bool TryGetSampleRate(out int sampleRate)
            {
                lock (_syncRoot)
                {
                    if (ResolveReadDisplayId() == _displayId)
                    {
                        sampleRate = _configuredSampleRate;
                    }
                    else
                    {
                        SyncTransmitterSettingsLocked();
                        sampleRate = _txConfiguredSampleRate;
                    }
                    return !_shutdown;
                }
            }

            public bool TryGetFFTSize(out int fftSize)
            {
                lock (_syncRoot)
                {
                    fftSize = _fftSize;
                    return !_shutdown;
                }
            }
            public bool TryGetHzSpan(out int hzSpan)
            {
                lock (_syncRoot)
                {
                    if (ResolveReadDisplayId() == _displayId)
                    {
                    hzSpan = _HzSpan;
                    }
                    else
                    {
                        SyncTransmitterSettingsLocked();
                        hzSpan = _txHzSpan;
                    }
                    return !_shutdown;
                }
            }
            public bool TryGetHzLeft(out int hzLeft)
            {
                lock (_syncRoot)
                {
                    if (ResolveReadDisplayId() == _displayId)
                    {
                        hzLeft = _HzLeft;
                    }
                    else
                    {
                        SyncTransmitterSettingsLocked();
                        hzLeft = _txHzLeft;
                    }
                    return !_shutdown;
                }
            }
            public void Shutdown()
            {
                lock (_syncRoot)
                {
                    if (_shutdown) return;

                    _shutdown = true;
                    _enabled = false;

                    try { cmaster.RunAnalyzer(_displayId, 0); } catch { }
                    try { cmaster.RunAnalyzer(_txDisplayId, 0); } catch { }
                    try { cmaster.FreeAnalyzer(_displayId); } catch { }
                    try { cmaster.FreeAnalyzer(_txDisplayId); } catch { }
                    ReturnPixelBuffer(ref _latestPixels);
                    ReturnPixelBuffer(ref _workingPixels);
                }
            }

            private void UpdateZoomCentreAnchorPositionLocked()
            {
                double centreHz = GetReceiverCentreFrequencyHz();
                double offsetHz = GetZoomCentreOffsetHzLocked(centreHz);
                int hzLeft = _HzLeft;
                int hzSpan = _HzSpan;

                if (ResolveReadDisplayId() == _txDisplayId)
                {
                    hzLeft = _txHzLeft;
                    hzSpan = _txHzSpan;
                }

                if (hzSpan > 0)
                {
                    _zoomCentreAnchorPosition = ClampPanSlider((offsetHz - hzLeft) / hzSpan);
                    return;
                }

                _zoomCentreAnchorPosition = CalculatePositionForCentreOffset(_configuredSampleRate, _fftSize, _zoomSlider, GetEffectivePanSliderLocked(), offsetHz);
            }

            private double GetZoomCentreOffsetHzLocked(double centreHz)
            {
                if (_zoomCentreTracksReceiverCentre) return _zoomCentreOffsetHz;
                return _zoomCentreFrequencyHz - centreHz;
            }

            private double GetReceiverCentreFrequencyHz()
            {
                double frequencyMHz = 0.0;
                if (_receiverId == 0)
                    frequencyMHz = _console.CentreFrequency;
                else if (_receiverId == 1)
                    frequencyMHz = _console.CentreRX2Frequency;

                return frequencyMHz * 1000000.0 + _console.GetDSPcwPitchShiftToZero(_receiverId + 1);
            }

            private double GetEffectivePanSliderLocked()
            {
                return IsZoomFullyOut(_zoomSlider) ? 0.5 : _panSlider;
            }

            private static bool IsZoomFullyOut(double zoomSlider)
            {
                return Math.Abs(ClampZoomSlider(zoomSlider)) < ViewportEpsilon;
            }

            private static double CalculatePanForCentreOffset(int sampleRate, int fftSize, double zoomSlider, double centreOffsetHz, double anchorPosition)
            {
                if (sampleRate <= 0 || fftSize <= 0) return 0.5;

                double binWidth = (double)sampleRate / (double)fftSize;
                int binsPerSubspan = fftSize - 1;
                double intervals = (double)(binsPerSubspan - 1);
                if (intervals <= 0.0 || binWidth <= 0.0) return 0.5;

                double zoom = Math.Log10(9.0 * ClampZoomSlider(zoomSlider) + 1.0);
                double width = intervals * (1.0 - (1.0 - 1.0 / 100.0) * zoom);
                double panWidth = intervals - width;
                if (panWidth <= 0.0) return 0.5;

                double anchor = ClampPanSlider(anchorPosition);
                return ClampPanSlider((centreOffsetHz / binWidth + intervals / 2.0 - anchor * width) / panWidth);
            }

            private static double CalculatePositionForCentreOffset(int sampleRate, int fftSize, double zoomSlider, double panSlider, double centreOffsetHz)
            {
                if (sampleRate <= 0 || fftSize <= 0) return 0.5;

                double binWidth = (double)sampleRate / (double)fftSize;
                int binsPerSubspan = fftSize - 1;
                double intervals = (double)(binsPerSubspan - 1);
                if (intervals <= 0.0 || binWidth <= 0.0) return 0.5;

                double zoom = Math.Log10(9.0 * ClampZoomSlider(zoomSlider) + 1.0);
                double width = intervals * (1.0 - (1.0 - 1.0 / 100.0) * zoom);
                if (width <= 0.0) return 0.5;

                double panWidth = intervals - width;
                double leftOffsetIntervals = -intervals / 2.0 + ClampPanSlider(panSlider) * panWidth;
                return ClampPanSlider((centreOffsetHz / binWidth - leftOffsetIntervals) / width);
            }

            private void CorrectZoomCentrePanFromAnalyzerLocked(SpecHPSDR spec, int sampleRate, double centreOffsetHz, double anchorPosition)
            {
                if (spec == null || sampleRate <= 0 || _fftSize <= 0) return;

                double binWidth = (double)sampleRate / (double)_fftSize;
                int binsPerSubspan = _fftSize - 1;
                double intervals = (double)(binsPerSubspan - 1);
                if (intervals <= 0.0 || binWidth <= 0.0) return;

                double zoom = Math.Log10(9.0 * ClampZoomSlider(_zoomSlider) + 1.0);
                double width = intervals * (1.0 - (1.0 - 1.0 / 100.0) * zoom);
                double panWidth = intervals - width;
                double panHzWidth = panWidth * binWidth;
                if (panHzWidth <= 0.0) return;

                double anchor = ClampPanSlider(anchorPosition);
                double correctionLimitHz = Math.Max(0.5, binWidth * 0.5);

                for (int iteration = 0; iteration < 3; iteration++)
                {
                    int span = spec.HighFreq - spec.LowFreq;
                    if (span <= 0) return;

                    double targetLeftHz = centreOffsetHz - anchor * span;
                    double correctionHz = targetLeftHz - spec.LowFreq;
                    if (Math.Abs(correctionHz) <= correctionLimitHz) return;

                    double correctedPanSlider = ClampPanSlider(_panSlider + correctionHz / panHzWidth);
                    if (Math.Abs(correctedPanSlider - _panSlider) < ViewportEpsilon) return;

                    _panSlider = correctedPanSlider;
                    spec.PanSlider = GetEffectivePanSliderLocked();
                    spec.Update = true;
                    spec.initAnalyzer();
                }
            }

            private void RefreshLocked()
            {
                if (_hasZoomCentreFrequency)
                {
                    double centreHz = GetReceiverCentreFrequencyHz();
                    double offsetHz = GetZoomCentreOffsetHzLocked(centreHz);
                    if (_zoomCentreTracksReceiverCentre)
                        _zoomCentreFrequencyHz = centreHz + _zoomCentreOffsetHz;

                    if (IsZoomFullyOut(_zoomSlider))
                        _panSlider = 0.5;
                    else
                        _panSlider = CalculatePanForCentreOffset(_configuredSampleRate, _fftSize, _zoomSlider, offsetHz, _zoomCentreAnchorPosition);
                }
                else if (IsZoomFullyOut(_zoomSlider))
                {
                    _panSlider = 0.5;
                }

                RefreshDisplaySpecLocked(_spec, _configuredSampleRate, _blockSize);
                RefreshDisplaySpecLocked(_txSpec, _txConfiguredSampleRate, _txBlockSize);
                ResetNoiseFloorLocked();
                _nextReadUtcTicks = 0;
            }

            private void RefreshDisplaySpecLocked(SpecHPSDR spec, int sampleRate, int blockSize)
            {
                spec.Update = false;
                spec.PixelOut = 1;
                spec.IgnoreFrequencyOffset = true;
                spec.FrameRate = _frameRate;
                spec.Pixels = _pixels;
                spec.DetTypePan = _detectorTypePan;
                spec.AvTau = _averageTau;
                spec.FFTSize = Math.Min(_fftSize, _maxFftSize);
                spec.BlockSize = blockSize;
                spec.SampleRate = sampleRate;
                spec.WindowType = _windowType;
                spec.AverageMode = _averageMode;
                spec.AverageOn = _averageOn;
                spec.PeakOn = _peakOn;
                spec.NormOneHzPan = _normOneHzPan;
                spec.ZoomSlider = _zoomSlider;
                spec.PanSlider = GetEffectivePanSliderLocked();
                //spec.UseClip = false;
                spec.Update = true;
                spec.initAnalyzer();

                if (spec == _spec && _hasZoomCentreFrequency && !IsZoomFullyOut(_zoomSlider))
                {
                    double centreHz = GetReceiverCentreFrequencyHz();
                    double offsetHz = GetZoomCentreOffsetHzLocked(centreHz);
                    CorrectZoomCentrePanFromAnalyzerLocked(spec, sampleRate, offsetHz, _zoomCentreAnchorPosition);
                }

                if (spec == _spec)
                {
                    _HzLeft = spec.LowFreq;
                    _HzSpan = spec.HighFreq - spec.LowFreq;
                }
                else if (spec == _txSpec)
                {
                    _txHzLeft = spec.LowFreq;
                    _txHzSpan = spec.HighFreq - spec.LowFreq;
                }
            }

            private static int ResolveDefaultBlockSize(int sampleRate)
            {
                int blockSize = cmaster.GetBuffSize(sampleRate);
                return blockSize > 0 ? blockSize : 2048;
            }

            private int ResolveReadDisplayId()
            {
                if (!IsReceiverInLocalMox())
                    return _displayId;

                if (_console.DisplayDuplex)
                    return _displayId;

                return _txDisplayId;
            }

            private float GetPixelOffset(int displayId)
            {
                if (displayId == _txDisplayId)
                    return Display.TXDisplayCalOffset;

                return _receiverId == 1 ? Display.RX2OffsetWithDup : Display.RX1OffsetWithDup;
            }

            private bool IsReceiverInLocalMox()
            {
                if (!Display.MOX)
                    return false;

                if (_receiverId == 0)
                    return !_console.VFOBTX || (_console.VFOBTX && !_console.RX2Enabled);

                if (_receiverId == 1)
                    return _console.VFOBTX && _console.RX2Enabled;

                return false;
            }

            private void SyncTransmitterSettingsLocked()
            {
                if (_console.specRX == null)
                    return;

                SpecHPSDR spec = _console.specRX.GetSpecRX(cmaster.inid(1, 0));
                if (spec == null)
                    return;

                int sampleRate = spec.SampleRate > 0 ? spec.SampleRate : _txConfiguredSampleRate;
                int blockSize = spec.BlockSize > 0 ? spec.BlockSize : ResolveDefaultBlockSize(sampleRate);
                if (sampleRate == _txConfiguredSampleRate && blockSize == _txBlockSize)
                    return;

                _txConfiguredSampleRate = sampleRate;
                _txBlockSize = blockSize;
                RefreshDisplaySpecLocked(_txSpec, _txConfiguredSampleRate, _txBlockSize);
            }

            private void EnsurePixelBuffersLocked(int pixels)
            {
                if (_latestPixels == null || _latestPixels.Length < pixels)
                {
                    ReturnPixelBuffer(ref _latestPixels);
                    _latestPixels = RentPixelBuffer(pixels);
                }

                if (_workingPixels == null || _workingPixels.Length < pixels)
            {
                    ReturnPixelBuffer(ref _workingPixels);
                    _workingPixels = RentPixelBuffer(pixels);
                }
            }

            private void ClearPixelBuffersLocked()
            {
                EnsurePixelBuffersLocked(_pixels);
                FillPixelBuffer(_latestPixels, _pixels);
                FillPixelBuffer(_workingPixels, _pixels);
            }

            private void ResetNoiseFloorLocked()
            {
                _noiseFloorGood = false;
                _fastAttackNoiseFloor = true;
                _noiseFloorUnshiftedDbm = DefaultNoiseFloorValue;
                _fftBinAverage = DefaultNoiseFloorValue;
                _lerpAverage = DefaultNoiseFloorValue;
                _lastFastAttackUtcTicks = 0;
            }

            private void ProcessNoiseFloorLocked(int averageCount, float averageSum, int width, long nowUtcTicks)
            {
                int requireSamples = (int)(width * (_owner.NFsensitivity / 20.0f));

                if (averageCount >= requireSamples)
                {
                    float linearAverage = averageSum / (float)averageCount;
                    float oldLinear = FastPow10Raw(_fftBinAverage);
                    float newLinear = (linearAverage + oldLinear) * 0.5f;
                    float tmp = 10.0f * (float)Math.Log10(newLinear + 1e-60);
                    if (!float.IsNaN(tmp)) _fftBinAverage = tmp;
                }
                else
                {
                    _fftBinAverage += _fastAttackNoiseFloor ? 3.0f : 1.0f;
                }

                if (_fftBinAverage < DefaultNoiseFloorValue) _fftBinAverage = DefaultNoiseFloorValue;
                if (_fftBinAverage > 200.0f) _fftBinAverage = 200.0f;

                int framesInAttack = _fastAttackNoiseFloor ? 0 : (int)((_frameRate / 1000.0f) * (double)_attackTimeInMs);
                framesInAttack++;

                float difference = _lerpAverage - _fftBinAverage;
                _lerpAverage -= difference / framesInAttack;

                if (_fastAttackNoiseFloor)
                {
                    if (_lastFastAttackUtcTicks <= 0) _lastFastAttackUtcTicks = nowUtcTicks;
                    long elapsedTicks = nowUtcTicks - _lastFastAttackUtcTicks;
                    if (elapsedTicks > TimeSpan.TicksPerSecond) _fastAttackNoiseFloor = false;
                }

                if (!_fastAttackNoiseFloor)
                {
                    _noiseFloorUnshiftedDbm = _lerpAverage;
                    _noiseFloorGood = true;
                }
            }

            [MethodImpl(MethodImplOptions.AggressiveInlining)]
            private static unsafe float FastPow10Raw(float dB)
            {
                if (dB <= -200.0f || dB >= 200.0f) return (float)Math.Pow(10.0, dB / 10.0);
                int bits = (int)(dB * FastPow10Scale) + FastPow10Bias;
                return *(float*)&bits;
            }

            private static float[] RentPixelBuffer(int pixels)
            {
                return PixelArrayPool.Rent(pixels);
            }

            private static void ReturnPixelBuffer(ref float[] buffer)
            {
                if (buffer == null) return;

                PixelArrayPool.Return(buffer, false);
                buffer = null;
            }

            private static void FillPixelBuffer(float[] data, int pixels)
            {
                for (int i = 0; i < pixels; i++)
                    data[i] = EmptyPixelValue;
            }
        }

        private sealed class SpectrumTestForm : Form
        {
            private readonly clsSpectrumProcessor _processor;
            private readonly int _receiverId;
            private readonly float? _minDbm;
            private readonly float? _maxDbm;
            private readonly SpectrumGraphPanel _graphPanel;
            private readonly System.Windows.Forms.Timer _refreshTimer;

            public SpectrumTestForm(clsSpectrumProcessor processor, int receiverId, float? minDbm, float? maxDbm)
            {
                _processor = processor;
                _receiverId = receiverId;
                _minDbm = minDbm;
                _maxDbm = maxDbm;

                Text = BuildTitle(receiverId, _minDbm, _maxDbm);
                StartPosition = FormStartPosition.CenterScreen;
                Size = new Size(900, 450);
                MinimumSize = new Size(320, 200);
                BackColor = Color.FromArgb(18, 18, 18);

                _graphPanel = new SpectrumGraphPanel(_processor, _receiverId, _minDbm, _maxDbm)
                {
                    Dock = DockStyle.Fill
                };

                Controls.Add(_graphPanel);

                _refreshTimer = new System.Windows.Forms.Timer
                {
                    Interval = 50
                };
                _refreshTimer.Tick += RefreshTimer_Tick;
                _refreshTimer.Start();

                FormClosed += SpectrumTestForm_FormClosed;
            }

            private static string BuildTitle(int receiverId, float? minDbm, float? maxDbm)
            {
                string suffix = string.Empty;
                if (minDbm.HasValue && maxDbm.HasValue && maxDbm.Value > minDbm.Value)
                    suffix = " [" + minDbm.Value.ToString("F0") + " to " + maxDbm.Value.ToString("F0") + " dBm]";

                return "Spectrum Test - RX" + (receiverId + 1).ToString() + suffix;
            }

            private void RefreshTimer_Tick(object sender, EventArgs e)
            {
                _graphPanel.Invalidate();
            }

            private void SpectrumTestForm_FormClosed(object sender, FormClosedEventArgs e)
            {
                _refreshTimer.Stop();
                _refreshTimer.Dispose();
            }
        }

        private sealed class SpectrumGraphPanel : Panel
        {
            private readonly clsSpectrumProcessor _processor;
            private readonly int _receiverId;
            private readonly float? _fixedMinDbm;
            private readonly float? _fixedMaxDbm;
            private readonly Pen _tracePen;
            private readonly Pen _gridPen;
            private readonly Brush _textBrush;
            private readonly Brush _backgroundBrush;
            private readonly Font _font;
            private float[] _pixelBuffer;

            public SpectrumGraphPanel(clsSpectrumProcessor processor, int receiverId, float? fixedMinDbm, float? fixedMaxDbm)
            {
                _processor = processor;
                _receiverId = receiverId;
                _fixedMinDbm = fixedMinDbm;
                _fixedMaxDbm = fixedMaxDbm;

                DoubleBuffered = true;
                ResizeRedraw = true;

                _tracePen = new Pen(Color.LimeGreen, 1.5f);
                _gridPen = new Pen(Color.FromArgb(45, 90, 90, 90), 1f);
                _textBrush = Brushes.Gainsboro;
                _backgroundBrush = new SolidBrush(Color.FromArgb(18, 18, 18));
                _font = new Font("Segoe UI", 9f, FontStyle.Regular);
                _pixelBuffer = new float[DefaultPixels];
            }

            protected override void Dispose(bool disposing)
            {
                if (disposing)
                {
                    _tracePen.Dispose();
                    _gridPen.Dispose();
                    _backgroundBrush.Dispose();
                    _font.Dispose();
                }

                base.Dispose(disposing);
            }

            protected override void OnPaint(PaintEventArgs e)
            {
                base.OnPaint(e);

                Graphics g = e.Graphics;
                g.Clear(Color.FromArgb(18, 18, 18));

                Rectangle plotRect = ClientRectangle;
                plotRect.Inflate(-12, -12);

                if (plotRect.Width < 10 || plotRect.Height < 10)
                    return;

                DrawGrid(g, plotRect);

                float[] pixels = _pixelBuffer;
                int pixelCount;
                int dataIndex;
                bool hasData = TryCopyPixels(out pixels, out pixelCount, out dataIndex);
                if (!hasData || pixels == null || pixelCount < 2)
                {
                    g.DrawString("Waiting for pixel data...", _font, _textBrush, plotRect.Left, plotRect.Top);
                    return;
                }

                float min = float.MaxValue;
                float max = float.MinValue;

                for (int i = 0; i < pixelCount; i++)
                {
                    if (pixels[i] < min) min = pixels[i];
                    if (pixels[i] > max) max = pixels[i];
                }

                if (min == float.MaxValue || max == float.MinValue)
                {
                    g.DrawString("No valid dBm data.", _font, _textBrush, plotRect.Left, plotRect.Top);
                    return;
                }

                float plotMin = min;
                float plotMax = max;
                bool fixedScale = _fixedMinDbm.HasValue && _fixedMaxDbm.HasValue && _fixedMaxDbm.Value > _fixedMinDbm.Value;
                if (fixedScale)
                {
                    plotMin = _fixedMinDbm.Value;
                    plotMax = _fixedMaxDbm.Value;
                }

                if (Math.Abs(plotMax - plotMin) < 0.001f)
                {
                    plotMax += 1.0f;
                    plotMin -= 1.0f;
                }

                float width = plotRect.Width - 1f;
                float height = plotRect.Height - 1f;
                float range = plotMax - plotMin;
                PointF[] segment = new PointF[pixelCount * 2];
                int segmentCount = 0;
                bool hasVisibleData = false;
                bool previousValid = false;
                float previousSample = 0f;
                float previousX = 0f;

                for (int i = 0; i < pixelCount; i++)
                {
                    float sample = pixels[i];
                    float x = plotRect.Left + (width * i / (pixelCount - 1f));
                    bool currentValid = sample >= plotMin;

                    if (currentValid)
                    {
                        if (previousValid)
                        {
                            float normalized = (sample - plotMin) / range;
                            if (normalized > 1f) normalized = 1f;
                            float y = plotRect.Bottom - (normalized * height);
                            segment[segmentCount++] = new PointF(x, y);
                        }
                        else
                        {
                            if (i > 0)
                            {
                                float delta = sample - previousSample;
                                float ratio = Math.Abs(delta) < 0.000001f ? 0f : (plotMin - previousSample) / delta;
                                if (ratio < 0f) ratio = 0f;
                                if (ratio > 1f) ratio = 1f;
                                float startX = previousX + ((x - previousX) * ratio);
                                segment[segmentCount++] = new PointF(startX, plotRect.Bottom);
                            }

                            float normalized = (sample - plotMin) / range;
                            if (normalized > 1f) normalized = 1f;
                            float y = plotRect.Bottom - (normalized * height);
                            segment[segmentCount++] = new PointF(x, y);
                        }

                        hasVisibleData = true;
                    }
                    else if (previousValid)
                    {
                        float delta = sample - previousSample;
                        float ratio = Math.Abs(delta) < 0.000001f ? 0f : (plotMin - previousSample) / delta;
                        if (ratio < 0f) ratio = 0f;
                        if (ratio > 1f) ratio = 1f;
                        float endX = previousX + ((x - previousX) * ratio);
                        segment[segmentCount++] = new PointF(endX, plotRect.Bottom);

                        if (segmentCount > 1)
                        {
                            PointF[] line = new PointF[segmentCount];
                            Array.Copy(segment, line, segmentCount);
                            g.DrawLines(_tracePen, line);
                        }

                        segmentCount = 0;
                    }

                    previousValid = currentValid;
                    previousSample = sample;
                    previousX = x;
                }

                if (segmentCount > 1)
                {
                    PointF[] line = new PointF[segmentCount];
                    Array.Copy(segment, line, segmentCount);
                    g.DrawLines(_tracePen, line);
                }

                if (!hasVisibleData)
                {
                    g.DrawString("No visible dBm data.", _font, _textBrush, plotRect.Left, plotRect.Top);
                    return;
                }

                string sourceText = _processor.IsReceiverShowingTransmitter(_receiverId)
                    ? "TX"
                    : "RX" + (_receiverId + 1).ToString();
                double zoomSlider;
                double panSlider;
                bool hasViewport = _processor.TryGetReceiverViewport(_receiverId, out zoomSlider, out panSlider);
                int sampleRate;
                bool hasSampleRate = _processor.TryGetReceiverSampleRate(_receiverId, out sampleRate);
                int fftSize;
                bool hasFftSize = _processor.TryGetReceiverFFTSize(_receiverId, out fftSize);

                string info = sourceText +
                    "  Pixels=" + pixelCount.ToString() +
                    "  Frame=" + dataIndex.ToString() +
                    "  Min=" + min.ToString("F1") +
                    " dBm  Max=" + max.ToString("F1") + " dBm";

                if (hasViewport)
                {
                    info += "  Zoom=" + zoomSlider.ToString("F3") +
                        "  Pan=" + panSlider.ToString("F3");
                }

                if (hasSampleRate)
                {
                    info += "  SR=" + sampleRate.ToString();
                }

                if (hasFftSize)
                {
                    info += "  FFT=" + fftSize.ToString();
                }

                if (fixedScale)
                {
                    info += "  Scale=" + plotMin.ToString("F1") + " to " + plotMax.ToString("F1") + " dBm";
                }

                SizeF textSize = g.MeasureString(info, _font);
                RectangleF textRect = new RectangleF(plotRect.Left, plotRect.Top, Math.Min(textSize.Width + 8f, plotRect.Width), textSize.Height + 4f);
                g.FillRectangle(_backgroundBrush, textRect);
                g.DrawString(info, _font, _textBrush, plotRect.Left + 2, plotRect.Top + 2);
            }

            private bool TryCopyPixels(out float[] pixels, out int pixelCount, out int dataIndex)
            {
                if (_pixelBuffer == null)
                    _pixelBuffer = new float[DefaultPixels];

                bool hasData = TryCopyPixelsWithBuffer(_pixelBuffer, out pixelCount, out dataIndex);
                if (pixelCount > _pixelBuffer.Length)
                {
                    _pixelBuffer = new float[pixelCount];
                    hasData = TryCopyPixelsWithBuffer(_pixelBuffer, out pixelCount, out dataIndex);
                }

                pixels = _pixelBuffer;
                return hasData;
            }

            private bool TryCopyPixelsWithBuffer(float[] destination, out int pixelCount, out int dataIndex)
            {
                return _processor.TryCopyReceiverPixels(_receiverId, destination, out pixelCount, out dataIndex);
            }

            private void DrawGrid(Graphics g, Rectangle plotRect)
            {
                const int verticalDivisions = 8;
                const int horizontalDivisions = 6;

                for (int i = 0; i <= verticalDivisions; i++)
                {
                    float x = plotRect.Left + (plotRect.Width * i / (float)verticalDivisions);
                    g.DrawLine(_gridPen, x, plotRect.Top, x, plotRect.Bottom);
                }

                for (int i = 0; i <= horizontalDivisions; i++)
                {
                    float y = plotRect.Top + (plotRect.Height * i / (float)horizontalDivisions);
                    g.DrawLine(_gridPen, plotRect.Left, y, plotRect.Right, y);
                }
            }
        }
    }
}
