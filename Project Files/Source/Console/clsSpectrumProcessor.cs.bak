namespace Thetis
{
    public sealed class clsSpectrumProcessor : IDisposable
    {
        private const int ReceiverAnalyzerType = 0;
        private const int TransmitterAnalyzerType = 1;

        public event Action FrameAvailable;

        private const int DefaultPixels = 1024;
        private const int DefaultFrameRate = 15;
        private const int DefaultMaxFftSize = 262144;
        private const int DefaultSampleRate = 192000;        
        private const int DefaultFftSize = 4096;
        private const int DefaultWindowType = 4;
        private const int DefaultDetectorTypePan = 0;
        private const int DefaultAverageMode = 0;
        private const double DefaultAverageTau = 0.12;
        private const float EmptyPixelValue = -200.0f;
        private const int DataIndexWrap = 1000000000;
        private const float DefaultNoiseFloorValue = -200.0f;
        private const int DefaultNoiseFloorSensitivity = 3;
        private const float DefaultNoiseFloorShiftDbm = 0.0f;
        private static readonly ArrayPool<float> PixelArrayPool = ArrayPool<float>.Shared;

        private readonly Console _console;
        private readonly object _endpointsLock = new object();
        private readonly Dictionary<int, SpectrumEndpoint> _endpoints;
        private readonly Thread _workerThread;
        private volatile SpectrumEndpoint[] _endpointSnapshot;

        private volatile bool _workerRunning;
        private int _NFsensitivity = DefaultNoiseFloorSensitivity;
        private float _fNFshiftDBM = DefaultNoiseFloorShiftDbm;
        private bool _disposed;

        public clsSpectrumProcessor(Console console)
        {
            if (console == null) throw new ArgumentNullException(nameof(console));

            _console = console;
            _endpoints = new Dictionary<int, SpectrumEndpoint>();
            _endpointSnapshot = Array.Empty<SpectrumEndpoint>();
            _workerRunning = true;

            SubscribeDelegates();

            _workerThread = new Thread(RunWorker)
            {
                Name = "Spectrum Processor Thread",
                IsBackground = true,
                Priority = ThreadPriority.Normal
            };
            _workerThread.Start();
        }

        public int NFsensitivity
        {
            get { return _NFsensitivity; }
            set
            {
                int t = value;
                if (t < 1) t = 1;
                if (t > 19) t = 19;
                _NFsensitivity = t;
            }
        }

        public float NFshiftDBM
        {
            get { return _fNFshiftDBM; }
            set
            {
                float t = value;
                if (t < -12f) t = -12f;
                if (t > 12f) t = 12f;
                _fNFshiftDBM = t;
            }
        }

        public bool AddReceiver(int receiverId, int pixels, int frameRate, int fftSize)
        {
            ThrowIfDisposed();
            ValidateReceiverId(receiverId);

            pixels = ClampInt(pixels, 64, 32768);
            frameRate = ClampInt(frameRate, 1, 120);
            fftSize = NormalizeFftSize(fftSize);

            SpecHPSDR templateSpec = _console.specRX != null ? _console.specRX.GetSpecRX(receiverId) : null;
            SpecHPSDR txTemplateSpec = _console.specRX != null ? _console.specRX.GetSpecRX(cmaster.inid(1, 0)) : null;
            SpectrumEndpoint endpoint = new SpectrumEndpoint(this, _console, receiverId, pixels, frameRate, fftSize, templateSpec, txTemplateSpec);

            lock (_endpointsLock)
            {
                if (_endpoints.ContainsKey(receiverId))
                {
                    endpoint.Shutdown();
                    return false;
                }

                _endpoints.Add(receiverId, endpoint);
                UpdateEndpointSnapshotLocked();
            }

            return true;
        }

        public bool RemoveReceiver(int receiverId)
        {
            SpectrumEndpoint endpoint;
            if (!TryDetachReceiverEndpoint(receiverId, out endpoint)) return false;

            endpoint.Shutdown();
            return true;
        }

        public void Clear()
        {
            SpectrumEndpoint[] endpoints;

            lock (_endpointsLock)
            {
                endpoints = _endpointSnapshot;
                _endpoints.Clear();
                _endpointSnapshot = Array.Empty<SpectrumEndpoint>();
            }

            for (int i = 0; i < endpoints.Length; i++)
                endpoints[i].Shutdown();
        }

        private bool ContainsReceiver(int receiverId)
        {
            ValidateReceiverId(receiverId);

            lock (_endpointsLock)
            {
                return _endpoints.ContainsKey(receiverId);
            }
        }

